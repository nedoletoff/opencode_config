{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "deepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek",
      "options": {
        "baseURL": "https://api.deepseek.com/v1"
      },
      "models": {
        "deepseek-flash": {
          "name": "DeepSeek-V4-Flash",
          "limit": {
            "context": 131072,
            "output": 16384
          },
          "options": {
            "thinking": {
              "type": "disabled"
            }
          }
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek-V4-Pro",
          "limit": {
            "context": 131072,
            "output": 262144
          },
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 8192
            }
          }
        }
      }
    }
  },
  "model": "deepseek/deepseek-flash",
  "plugin": [
    "@tianhuil/opencode-dotenv",
    "opencode-deepseek-thinking-fix",
    "agent-cache-optimizer",
    "@tarquinen/opencode-dcp@latest",
    "opencode-snip@latest",
    "opencode-context-manager@latest"
  ],
  "compaction": {
    "auto": true
  }
}
