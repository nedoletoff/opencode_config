{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "deepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek",
      "options": {
        "baseURL": "https://api.deepseek.com/v1"
      },
      "models": {
        "deepseek-flash": {
          "name": "DeepSeek-V4-Flash",
          "limit": {
            "context": 1000000,
            "output": 393216
          },
          "options": {
            "thinking": {
              "type": "disabled"
            }
          }
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek-V4-Pro",
          "limit": {
            "context": 1000000,
            "output": 393216
          },
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 8192
            }
          }
        }
      }
    }
  },
  "model": "deepseek/deepseek-flash",
  "plugins": [
    "@tarquinen/opencode-dcp",
    "@cortexkit/opencode-magic-context"
  ],
  "compaction": {
    "auto": false
  }
}
